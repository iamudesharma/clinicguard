# --- LiveKit Cloud (free Build plan) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# --- STT ---
# whisper = local faster-whisper on this machine (free, unlimited, en+hi)
# deepgram = streaming Nova-3 (uses the free $200 credit)
STT_BACKEND=whisper
WHISPER_MODEL=base          # tiny | base | small — multilingual (en+hi), no ".en" suffix
WHISPER_LANGUAGE=           # empty = auto-detect per segment
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
DEEPGRAM_API_KEY=your_deepgram_key

# --- LLM ---
# --- LLM ---
# opencode = OpenCode Zen API (your subscription): key at https://opencode.ai/auth
#   deepseek-v4-flash-free = $0 (works without balance) | deepseek-v4-flash = paid, needs credits
# groq = free tier (llama-3.3-70b-versatile @ 280 t/s). openrouter = OpenRouter free models.
# LLM_FALLBACK_BACKEND enables automatic 429 failover to the other provider (with cooldown).
LLM_BACKEND=opencode
LLM_FALLBACK_BACKEND=groq
OPENCODE_API_KEY=your_opencode_zen_key
OPENCODE_MODEL=deepseek-v4-flash-free
# OPENCODE_MODEL=deepseek-v4-flash   # after adding credits to your workspace
GROQ_API_KEY=your_groq_key
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-oss-20b:free
LLM_COOLDOWN_SECONDS=60

# --- TTS ---
# piper = local piper-tts (free, unlimited; en_US-lessac-medium + hi_IN-rohan-medium,
#         auto-switched by script detection). Voices download to server/models/piper on first run.
# cartesia = cloud Sonic 3.5 (free 20k credits/mo, multilingual incl. Hindi)
TTS_BACKEND=piper
CARTESIA_API_KEY=your_cartesia_key
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# fish: LiveKit Inference "fishaudio/s2.1-pro-free" (en-only). Requires LiveKit Cloud project.
# TTS_BACKEND=fish
# FISH_VOICE_ID=bf322df2096a46f18c579d0baa36f41d

# --- Supabase (optional; omit to use in-memory demo store) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# --- Agent ---
AGENT_NAME=triage-dispatch
ROOM_PREFIX=clinic
