# --- LiveKit Cloud (free Build plan) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# --- STT ---
# whisper = local faster-whisper on this machine (free, unlimited, en+hi)
# deepgram = streaming Nova-3 (uses the free $200 credit)
STT_BACKEND=whisper
WHISPER_MODEL=base          # tiny | base | small — multilingual (en+hi), no ".en" suffix
WHISPER_LANGUAGE=           # empty = auto-detect per segment
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
DEEPGRAM_API_KEY=your_deepgram_key

# --- LLM ---
# opencode = OpenCode Zen API (your subscription): key at https://opencode.ai/auth
#   laguna-s-2.1-free = $0, NO thinking (fastest voice replies) | deepseek-v4-flash-free = $0, thinks first
# groq = free tier (llama-3.3-70b-versatile @ 280 t/s). openrouter = OpenRouter free models.
# gemini = Google Gemini via OpenAI-compatible endpoint: key at aistudio.google.com
#   (free tier or Google AI Pro rate limits), base URL https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_FALLBACK_BACKEND enables automatic 429 failover to the other provider (with cooldown).
LLM_BACKEND=gemini
LLM_FALLBACK_BACKEND=groq
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.7-flash
OPENCODE_API_KEY=your_opencode_zen_key
OPENCODE_MODEL=laguna-s-2.1-free
# OPENCODE_MODEL=deepseek-v4-flash-free   # thinking model, slower replies
GROQ_API_KEY=your_groq_key
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openai/gpt-oss-20b:free
LLM_COOLDOWN_SECONDS=60

# --- TTS ---
# piper = local piper-tts (free, unlimited; en_US-lessac-medium + hi_IN-rohan-medium,
#         auto-switched by script detection). Voices download to server/models/piper on first run.
# cartesia = cloud Sonic 3.5 (free 20k credits/mo, multilingual incl. Hindi)
TTS_BACKEND=piper
CARTESIA_API_KEY=your_cartesia_key
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# fish: LiveKit Inference "fishaudio/s2.1-pro-free" (en-only). Requires LiveKit Cloud project.
# TTS_BACKEND=fish
# FISH_VOICE_ID=bf322df2096a46f18c579d0baa36f41d

# --- Supabase (optional; omit to use in-memory demo store) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# --- Embeddings / RAG (optional; omit -> retrieval returns empty) ---
# Retrieval mode: keyword (default, Postgres FTS via Supabase RPC — no
# query-time embedding call) | vector (semantic, embeds the query) | hybrid.
# Embeddings are only needed for vector/hybrid (or for /rag/ingest + the
# rag_build script). Any OpenAI-compatible /embeddings endpoint works:
#   1. EMBEDDING_* below, else
#   2. OPENAI_API_KEY (text-embedding-3-small), else
#   3. OPENROUTER_API_KEY -> free nvidia/nemotron-3-embed-1b:free (2048-dim)
# Vector dims are unconstrained in the schema, so any provider works. Enable
# pgvector once in the Supabase SQL editor:  create extension vector;
# RAG_SEARCH_MODE=keyword
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your_embedding_key
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=3
# RAG_MAX_CONTEXT_CHARS=2400

# --- Agent ---
AGENT_NAME=triage-dispatch
ROOM_PREFIX=clinic
