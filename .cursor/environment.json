{
  "name": "ClinicGuard",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd server && uv run uvicorn api.main:app --reload --host 0.0.0.0 --port 8000"
    },
    {
      "name": "agent",
      "command": "cd voice_forge/examples/clinicguard_agent && dart run bin/agent.dart"
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "agent-signal", "port": 8765 }
  ]
}
